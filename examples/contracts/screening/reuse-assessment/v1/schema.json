      "type": "integer"
    },
    "reuse_feasibility_reason_zh": {
      "title": "Reuse Feasibility Reason Zh",
      "type": "string"
    }
  },
  "required": [
    "reuse_feasibility",
    "reuse_feasibility_reason_zh",
    "required_adaptations",
    "excerpt_kind",
    "excerpt_ids"
  ],
  "title": "ReuseAssessmentOutput",
  "type": "object",
  "x-paper-radar-contract": {
    "name": "reuse-assessment",
    "version": "v1"
  }
}
