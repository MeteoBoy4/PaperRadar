#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

if [[ "${1:-}" == "--help" && "$#" -eq 1 ]]; then
  help_python="${UV_PROJECT_ENVIRONMENT:-$repository_root/.venv}/bin/python"
  if [[ ! -x "$help_python" ]]; then
    help_python=python3
  fi
  exec "$help_python" -B -c 'from scripts.verification_groups import help_text; print(help_text())'
fi

if [[ "$#" -ne 0 ]]; then
  echo "未知参数；请运行 ./scripts/check-offline --help。" >&2
  exit 2
fi

export UV_NO_PROGRESS=1
exec uv run --offline --locked python -m scripts.a1_acceptance
