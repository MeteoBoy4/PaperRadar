#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

if [[ "${1:-}" == "--help" && "$#" -eq 1 ]]; then
  cat <<'EOF'
用法：./scripts/check-offline

执行固定完整离线检查：lockfile、格式、静态规则、类型、全部测试与四份冻结契约。
副作用：离线测试与迁移验收使用临时数据库，不操作用户数据库；不访问网络或模型。
输出：在 verification-runs/ 新建同次离线证据、A1、A2-01、完整 A2、A3、A4 与 A5 独立结论（七份主要文件，另有 pytest 执行回执与控制方终态记录）。
查询：./scripts/verification-status <run_id> [--runs-dir <目录>] [--json]；缺少终态记录不证明完成。
结果：只有本次 A1、完整 A2、A3、A4 与 A5 都通过才返回 0；阶段 A、live 与自动精读未验收。
常见失败：依赖未准备、检查失败、快照缺失或漂移、运行中断；按结论 reasons 与离线证据定位。
未知参数：返回 2 并提示查看本帮助。
示例：./scripts/check-offline
EOF
  exit 0
fi

if [[ "$#" -ne 0 ]]; then
  echo "未知参数；请运行 ./scripts/check-offline --help。" >&2
  exit 2
fi

export UV_NO_PROGRESS=1
exec uv run --offline --locked python -m scripts.a1_acceptance
